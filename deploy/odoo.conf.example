[options]
admin_passwd = CHANGE_ME_LONG_RANDOM_PASSWORD
addons_path = /opt/odoo/odoo/addons,/opt/odoo/odoo/odoo/addons
data_dir = /var/lib/odoo
db_host = False
db_port = False
db_user = odoo
db_password = False
http_interface = 0.0.0.0
http_port = 8069
logfile = /var/log/odoo/odoo.log
proxy_mode = True
workers = 2
max_cron_threads = 1
limit_time_cpu = 600
limit_time_real = 1200
