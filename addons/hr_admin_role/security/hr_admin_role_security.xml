<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="res_groups_privilege_hr_admin" model="res.groups.privilege">
            <field name="name">HR Administration</field>
            <field name="category_id" ref="base.module_category_human_resources"/>
        </record>

        <record id="group_hr_admin" model="res.groups">
            <field name="name">HR Admin</field>
            <field name="sequence">90</field>
            <field name="comment">HR administrator access with focused Settings access for users, languages, companies, and about.</field>
            <field name="privilege_id" ref="res_groups_privilege_hr_admin"/>
            <field name="implied_ids" eval="[Command.unlink(ref('base.group_system')), Command.link(ref('base.group_erp_manager')), Command.link(ref('stock.group_stock_manager'))]"/>
        </record>

        <record id="base.menu_administration" model="ir.ui.menu">
            <field name="group_ids" eval="[Command.link(ref('group_hr_admin'))]"/>
        </record>

        <record id="base.menu_users" model="ir.ui.menu">
            <field name="group_ids" eval="[Command.link(ref('group_hr_admin'))]"/>
        </record>

        <record id="base.menu_translation" model="ir.ui.menu">
            <field name="group_ids" eval="[Command.link(ref('group_hr_admin'))]"/>
        </record>

        <record id="base.menu_config" model="ir.ui.menu">
            <field name="group_ids" eval="[Command.link(ref('group_hr_admin'))]"/>
        </record>

        <record id="base_setup.menu_config" model="ir.ui.menu">
            <field name="group_ids" eval="[Command.link(ref('group_hr_admin'))]"/>
        </record>

    </data>
</odoo>
