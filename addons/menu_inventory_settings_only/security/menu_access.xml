<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="base.group_user" model="res.groups">
        <field name="implied_ids" eval="[Command.unlink(ref('stock.group_stock_user'))]"/>
    </record>

    <record id="base.menu_administration" model="ir.ui.menu">
        <field name="group_ids" eval="[Command.set([ref('base.group_user'), ref('base.group_system')])]"/>
    </record>

    <record id="base.menu_users" model="ir.ui.menu">
        <field name="group_ids" eval="[Command.set([ref('base.group_system')])]"/>
    </record>

    <record id="base.menu_custom" model="ir.ui.menu">
        <field name="group_ids" eval="[Command.set([ref('base.group_system')])]"/>
    </record>

    <record id="base.menu_management" model="ir.ui.menu">
        <field name="group_ids" eval="[Command.set([ref('base.group_system')])]"/>
    </record>

    <record id="base.menu_config" model="ir.ui.menu">
        <field name="group_ids" eval="[Command.set([ref('base.group_system')])]"/>
    </record>

    <record id="base_setup.menu_config" model="ir.ui.menu">
        <field name="group_ids" eval="[Command.set([ref('base.group_system')])]"/>
    </record>

    <record id="stock.menu_stock_root" model="ir.ui.menu">
        <field name="group_ids" eval="[Command.set([ref('base.group_user'), ref('stock.group_stock_user'), ref('stock.group_stock_manager')])]"/>
    </record>

    <record id="stock.in_picking" model="ir.ui.menu">
        <field name="group_ids" eval="[Command.set([ref('base.group_user'), ref('stock.group_stock_user'), ref('stock.group_stock_manager')])]"/>
    </record>

    <record id="stock.out_picking" model="ir.ui.menu">
        <field name="group_ids" eval="[Command.set([ref('base.group_user'), ref('stock.group_stock_user'), ref('stock.group_stock_manager')])]"/>
    </record>

    <record id="stock.menu_warehouse_report" model="ir.ui.menu">
        <field name="group_ids" eval="[Command.set([ref('base.group_user'), ref('stock.group_stock_manager')])]"/>
    </record>

    <record id="stock.menu_valuation" model="ir.ui.menu">
        <field name="group_ids" eval="[Command.set([ref('base.group_user'), ref('stock.group_stock_multi_locations'), ref('stock.group_tracking_owner')])]"/>
    </record>

    <record id="action_my_settings" model="ir.actions.server">
        <field name="name">My Settings</field>
        <field name="model_id" ref="base.model_res_users"/>
        <field name="state">code</field>
        <field name="group_ids" eval="[Command.link(ref('base.group_user'))]"/>
        <field name="code">action = env["res.users"].action_get()
action["res_id"] = env.uid
action["target"] = "current"</field>
    </record>

    <menuitem
        id="menu_my_settings"
        name="My Settings"
        parent="base.menu_administration"
        action="action_my_settings"
        sequence="10"
        groups="base.group_user"/>
</odoo>
